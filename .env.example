# adresse courriel
MY_EMAIL=votre-email@example.com

# sous-domaine DuckDNS
MY_DOMAIN=mondomaine.duckdns.org

# Token DuckDNS
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

## NEXTCLOUD

# Mot de passe de la base de données Nextcloud
DB_PASSWORD=changeme_password

# Nom de la base de données
DB_DATABASE=nextcloud

# Utilisateur de la base de données
DB_USER=nextcloud

## BLOGVERSE

# Mot de passe root MySQL de BlogVerse
MYSQL_ROOT_PASSWORD=changeme_root_password

# Nom de la base de données BlogVerse
MYSQL_DATABASE=blogverse

# Nom d'utilisateur MySQL de BlogVerse
MYSQL_USER=blogverse_user

# Mot de passe de l'utilisateur MySQL de BlogVerse
MYSQL_PASSWORD=changeme_blogverse_password

## BLOGVERSE – Backend

# Version de l'image Docker du backend (tag Docker Hub)
BACKEND_VERSION=1.0

# Clé secrète JWT (doit être longue et aléatoire en production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Durée de validité des tokens JWT
JWT_EXPIRES_IN=7d

## BLOGVERSE – Frontend

# Version de l'image Docker du frontend (tag Docker Hub)
FRONTEND_VERSION=1.0